  restrictedReviewerId String?
  status               String       @default("OPEN") // OPEN | INVESTIGATING | RESOLVED | ESCALATED
  resolutionNote       String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model JobVacancy {
