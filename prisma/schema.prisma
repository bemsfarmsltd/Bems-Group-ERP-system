  updatedAt      DateTime       @updatedAt
}

// ============================================================================
// PROJECT MANAGEMENT SYSTEM (Linear + Jira + Asana Unified Engine)
// ============================================================================

model ProjectPortfolio {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  ownerId        String?
  status         String       @default("ACTIVE") // ACTIVE | ON_HOLD | CLOSED
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  projects       Project[]
}

model ProjectGoal {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  title             String
  description       String?
  ownerId           String?
  measurementPeriod String       @default("Q4 2026")
  targetValue       Float        @default(100)
  currentValue      Float        @default(0)
  unit              String       @default("%")
  status            String       @default("ON_TRACK") // ON_TRACK | AT_RISK | OFF_TRACK | ACHIEVED
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  projects          Project[]
}

model ProjectWorkflow {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  name           String
  departmentType String        @default("GENERAL") // ENGINEERING | OPERATIONS | PROCUREMENT | GENERAL
  version        Int           @default(1)
  statusesJson   String        // JSON array of { key, label, category, color }
  transitionsJson String       // JSON map of permitted transitions + rules
  isDefault      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  projects       Project[]
}

model Project {
  id                 String           @id @default(uuid())
  projectCode        String           @unique // e.g. BEMS-PM-001
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id])
  departmentId       String?
  department         Department?      @relation(fields: [departmentId], references: [id])
  teamId             String?
  team               ProjectTeam?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  portfolioId        String?
  portfolio          ProjectPortfolio? @relation(fields: [portfolioId], references: [id])
  goalId             String?
  goal               ProjectGoal?     @relation(fields: [goalId], references: [id])
  kpiDefinitionId    String?
  kpiDefinition      KpiDefinition?   @relation(fields: [kpiDefinitionId], references: [id], onDelete: SetNull)
  workflowId         String?
  workflow           ProjectWorkflow? @relation(fields: [workflowId], references: [id])
  templateKey        String?          // SOFTWARE_DEV | ERP_IMPL | GOV_REVENUE | HARDWARE | etc.
  title              String
  description        String?
  objectives         String?
  deliverablesSummary String?
  projectType        String           @default("OPERATIONS") // SOFTWARE | OPERATIONS | INFRASTRUCTURE | ADMINISTRATION | FINANCE | PROCUREMENT | MEDIA | AGRIBUSINESS
  methodology        String           @default("HYBRID") // AGILE | SCRUM | KANBAN | WATERFALL | HYBRID
  visibility         String           @default("COMPANY") // PRIVATE | TEAM | COMPANY | GROUP | EXTERNAL
  status             String           @default("DRAFT_PROPOSAL") // DRAFT_PROPOSAL | SUBMITTED_FOR_APPROVAL | APPROVED_PLANNED | ACTIVE | ON_HOLD | DELIVERY_ACCEPTANCE | COMPLETED | REJECTED | CANCELLED | REOPENED
  priority           String           @default("MEDIUM") // URGENT | HIGH | MEDIUM | LOW
  healthStatus       String           @default("ON_TRACK") // ON_TRACK | AT_RISK | OFF_TRACK | PENDING_REVIEW
  healthUpdateAt     DateTime?
  sponsorId          String?
  sponsor            Employee?        @relation("ProjectSponsor", fields: [sponsorId], references: [id])
  managerId          String?
  manager            Employee?        @relation("ProjectManager", fields: [managerId], references: [id])
  teamLeadId         String?
  teamLead           Employee?        @relation("ProjectTeamLead", fields: [teamLeadId], references: [id], onDelete: SetNull)
  parentProjectId    String?
  parentProject      Project?         @relation("ProjectHierarchy", fields: [parentProjectId], references: [id], onDelete: SetNull)
  subProjects        Project[]        @relation("ProjectHierarchy")
  githubRepoUrl      String?
  githubBranch       String?          @default("main")
  githubSyncEnabled  Boolean          @default(false)
  startDate          String?
  targetDate         String?
  actualEndDate      String?
  baselineStartDate  String?
  baselineTargetDate String?
  proposedBudgetMinor BigInt          @default(0)
  approvedBudgetMinor BigInt          @default(0)
  currency           String           @default("NGN")
  progressPercent    Int              @default(0)
  version            Int              @default(1)
  createdById        String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  members            ProjectMember[]
  milestones         ProjectMilestone[]
  sprints            ProjectSprint[]
  workItems          ProjectWorkItem[]
  comments           ProjectComment[]
  timeEntries        ProjectTimeEntry[]
  documents          ProjectDocument[]
  decisions          ProjectDecision[]
  approvals          ProjectApproval[]
  risks              ProjectRisk[]
  changeRequests     ProjectChangeRequest[]
  releases           ProjectRelease[]
  testCases          ProjectTestCase[]
  automations        ProjectAutomationRule[]
  expenditureRequests ExpenditureRequest[]
  budgets            Budget[]
  statusUpdates      ProjectStatusUpdate[]
  staffHandovers     ProjectStaffHandover[]
  credentialEntries  ProjectCredentialEntry[]
  chatChannels       ProjectChatChannel[]
  chatMessages       ProjectChatMessage[]

  @@index([organizationId, status])
  @@index([parentProjectId])
}

model ProjectMember {
  id                     String    @id @default(uuid())
  projectId              String
  project                Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId             String
  employee               Employee  @relation(fields: [employeeId], references: [id])
  projectRole            String    @default("PROJECT_MEMBER") // PROJECT_SPONSOR | PROJECT_MANAGER | PROGRAM_MANAGER | PRODUCT_OWNER | TEAM_LEAD | DEVELOPER | DESIGNER | QA_ENGINEER | OPERATIONS_OFFICER | REVIEWER | APPROVER | OBSERVER | EXTERNAL_COLLABORATOR
  raciRole               String    @default("R") // R | A | C | I
  allocationPercent      Int       @default(100)
  assignedStartDate      String?
  targetCompletionDate   String?
  completedAt            DateTime?
  slaStatus              String    @default("ON_TRACK") // ON_TRACK | AT_RISK | OVERDUE | COMPLETED_ON_TIME | COMPLETED_LATE
  performanceImpactNote  String?
  salaryDeductionFlagged Boolean   @default(false)
  proposedDeductionMinor BigInt    @default(0)
  deductionAdjustmentId  String?
  createdAt              DateTime  @default(now())

  @@unique([projectId, employeeId])
}

model ProjectMilestone {
  id                  String   @id @default(uuid())
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  ownerId             String?
  dueDate             String?
  completedAt         DateTime?
  status              String   @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | DELAYED
  approvalStatus      String   @default("PENDING") // PENDING | APPROVED | REVISION_REQUESTED
  deliverablesSummary String?
  weightPercent       Int      @default(25)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workItems           ProjectWorkItem[]
}

model ProjectSprint {
  id                 String       @id @default(uuid())
  projectId          String?
  project            Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamId             String?
  team               ProjectTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  organizationId     String
  cycleNumber        Int          @default(1)
  name               String
  goal               String?
  startDate          String
  endDate            String
  capacityPoints     Int          @default(40)
  cooldownDays       Int          @default(0)
  carriedOverCount   Int          @default(0)
  status             String       @default("PLANNED") // PLANNED | ACTIVE | COMPLETED
  reviewNotes        String?
  retrospectiveNotes String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workItems          ProjectWorkItem[]
}

model ProjectWorkItem {
  id                 String            @id @default(uuid())
  itemKey            String            @unique // e.g. BEMS-101
  projectId          String
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizationId     String
  departmentId       String?
  department         Department?       @relation(fields: [departmentId], references: [id])
  teamId             String?
  team               ProjectTeam?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  milestoneId        String?
  milestone          ProjectMilestone? @relation(fields: [milestoneId], references: [id])
  sprintId           String?
  sprint             ProjectSprint?    @relation(fields: [sprintId], references: [id])
  parentId           String?
  parent             ProjectWorkItem?  @relation("WorkItemHierarchy", fields: [parentId], references: [id])
  subtasks           ProjectWorkItem[] @relation("WorkItemHierarchy")
  itemType           String            @default("TASK") // TASK | SUBTASK | EPIC | STORY | BUG | FEATURE | IMPROVEMENT | SPIKE | INCIDENT | CHANGE_REQUEST | APPROVAL_ITEM | OPERATIONAL_ACTION | RECURRING_TASK
  title              String
  description        String?
  status             String            @default("TODO") // BACKLOG | TODO | IN_PROGRESS | IN_REVIEW | QA_TESTING | BLOCKED | DONE | ACCEPTED | ARCHIVED
  priority           String            @default("MEDIUM") // URGENT | HIGH | MEDIUM | LOW
  severity           String?           // CRITICAL | MAJOR | MINOR | TRIVIAL (for Bugs)
  environment        String?           // DEVELOPMENT | STAGING | PRODUCTION
  storyPoints        Int?
  estimatedHours     Float?
  assigneeId         String?
  assignee           Employee?         @relation("WorkItemAssignee", fields: [assigneeId], references: [id])
  reporterId         String?
  reporter           Employee?         @relation("WorkItemReporter", fields: [reporterId], references: [id])
  reviewerId         String?
  reviewer           Employee?         @relation("WorkItemReviewer", fields: [reviewerId], references: [id])
  startDate          String?
  dueDate            String?
  slaDueAt           DateTime?
  triagedAt          DateTime?
  completedAt        DateTime?
  isBlocked          Boolean           @default(false)
  blockerReason      String?
  checklistJson      String?
  acceptanceCriteria String?
  labelsJson         String?
  customFieldsJson   String?
  version            Int               @default(1)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  blockedByLinks     ProjectDependency[] @relation("DependencyTarget")
  blocksLinks        ProjectDependency[] @relation("DependencySource")
  comments           ProjectComment[]
  timeEntries        ProjectTimeEntry[]
  testCases          ProjectTestCase[]
  subscriptions      ProjectWorkItemSubscription[]
  activityLogs       ProjectActivityLog[]
  expenditureRequests ExpenditureRequest[]

  @@index([projectId, status])
  @@index([assigneeId, status])
}

model ProjectDependency {
  id             String          @id @default(uuid())
  sourceItemId   String
  sourceItem     ProjectWorkItem @relation("DependencySource", fields: [sourceItemId], references: [id], onDelete: Cascade)
  targetItemId   String
  targetItem     ProjectWorkItem @relation("DependencyTarget", fields: [targetItemId], references: [id], onDelete: Cascade)
  dependencyType String          @default("FINISH_TO_START") // FINISH_TO_START | START_TO_START | FINISH_TO_FINISH | START_TO_FINISH | BLOCKS | RELATED_TO | DUPLICATES
  lagDays        Int             @default(0)
  createdAt      DateTime        @default(now())

  @@unique([sourceItemId, targetItemId, dependencyType])
}

model ProjectComment {
  id              String           @id @default(uuid())
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItemId      String?
  workItem        ProjectWorkItem? @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  authorId        String
  author          Employee         @relation(fields: [authorId], references: [id])
  body            String
  isInternal      Boolean          @default(false)
  parentCommentId String?
  mentionsJson    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ProjectTimeEntry {
  id             String           @id @default(uuid())
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItemId     String?
  workItem       ProjectWorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id])
  workDate       String
  hours          Float
  description    String
  isBillable     Boolean          @default(true)
  approvalStatus String           @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ProjectDocument {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  category        String   @default("SPECIFICATION") // CHARTER | BRD | PRD | TECHNICAL_DESIGN | API_SPEC | ARCHITECTURE | DEPLOYMENT_PLAN | TEST_PLAN | CONTRACT | MEETING_MINUTES | PROGRESS_REPORT | ACCEPTANCE_CERT | CLOSURE_REPORT | FIELD_MEDIA
  assetKind       String   @default("DOCUMENT") // DOCUMENT | IMAGE | DIAGRAM | FIELD_MEDIA
  mimeType        String?
  fileSizeBytes   Int?
  storagePath     String?
  contentMarkdown String?
  fileUrl         String?
  version         Int      @default(1)
  approvalStatus  String   @default("DRAFT") // DRAFT | IN_REVIEW | APPROVED
  authorId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProjectDecision {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  decision        String
  reason          String
  alternatives    String?
  decisionMakerId String
  impactSummary   String?
  approvedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
}

model ProjectApproval {
  id            String    @id @default(uuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category      String    // PROJECT_AUTH | BUDGET | SCOPE | CHANGE_REQUEST | PROCUREMENT | DESIGN | TASK_ACCEPTANCE | MILESTONE_ACCEPTANCE | TESTING | RELEASE | RESOURCE | CLOSURE
  title         String
  requestedById String
  reviewerId    String?
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED | REVISION_REQUESTED
  snapshotJson  String?
  decisionNote  String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ProjectRisk {
  id              String    @id @default(uuid())
  riskCode        String    @unique
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recordType      String    @default("RISK") // RISK | ISSUE | BLOCKER
  title           String
  description     String
  category        String    @default("OPERATIONAL")
  probability     String    @default("MEDIUM")
  impact          String    @default("MEDIUM")
  severity        String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status          String    @default("OPEN") // OPEN | MITIGATING | RESOLVED | CLOSED
  ownerId         String?
  owner           Employee? @relation(fields: [ownerId], references: [id])
  mitigationPlan  String?
  contingencyPlan String?
  reviewDate      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ProjectChangeRequest {
  id                 String   @id @default(uuid())
  changeCode         String   @unique
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title              String
  existingScope      String
  proposedChange     String
  reason             String
  budgetImpactMinor  BigInt   @default(0)
  timelineImpactDays Int      @default(0)
  riskImpact         String?
  status             String   @default("PENDING") // PENDING | APPROVED | REJECTED | IMPLEMENTED
  requestedById      String
  approvedById       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ProjectRelease {
  id           String    @id @default(uuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionTag   String
  title        String
  environment  String    @default("PRODUCTION") // STAGING | PRODUCTION | FIELD_DEPLOYMENT
  plannedDate  String?
  deployedAt   DateTime?
  status       String    @default("PLANNED") // PLANNED | DEV_COMPLETE | QA_VERIFIED | RELEASE_CANDIDATE | APPROVED | DEPLOYED | VERIFIED | CLOSED
  rollbackPlan String?
  releaseNotes String?
  ownerId      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ProjectTestCase {
  id             String           @id @default(uuid())
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItemId     String?
  workItem       ProjectWorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  title          String
  suiteName      String           @default("Regression")
  steps          String
  expectedResult String
  lastRunStatus  String           @default("NOT_RUN") // NOT_RUN | PASS | FAIL | BLOCKED
  executedById   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ProjectIntakeForm {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  title           String
  category        String       @default("WORK_REQUEST")
  fieldsJson      String
  isActive        Boolean      @default(true)
  submissionCount Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model ProjectAutomationRule {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  projectId        String?
  project          Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  triggerType      String
  conditionsJson   String
  actionType       String
  actionConfigJson String
  isActive         Boolean      @default(true)
  lastTriggeredAt  DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model ProjectTeam {
  id                  String              @id @default(uuid())
  organizationId      String
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key                 String              // e.g. BEM, OPS, ENG
  name                String
  description         String?
  color               String              @default("#ea580c")
  cyclesEnabled       Boolean             @default(true)
  cycleDurationDays   Int                 @default(14)
  cycleCooldownDays   Int                 @default(0)
  cycleAutomationJson String?             // { autoAddActive: boolean, autoAddStarted: boolean, autoAddCompleted: boolean, carryOverUnfinished: boolean }
  triageEnabled       Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  members             ProjectTeamMember[]
  projects            Project[]
  workItems           ProjectWorkItem[]
  sprints             ProjectSprint[]
  labels              ProjectLabel[]
  savedViews          ProjectSavedView[]
  slaRules            ProjectSlaRule[]

  @@unique([organizationId, key])
}

model ProjectTeamMember {
  id         String      @id @default(uuid())
  teamId     String
  team       ProjectTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role       String      @default("MEMBER") // LEAD | MEMBER
  joinedAt   DateTime    @default(now())

  @@unique([teamId, employeeId])
}

model ProjectLabel {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamId         String?
  team           ProjectTeam? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  scope          String       @default("ISSUE") // ISSUE | PROJECT
  name           String
  color          String       @default("#3b82f6")
  description    String?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, scope, name])
}

model ProjectSavedView {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamId         String?
  team           ProjectTeam? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  ownerId        String
  name           String
  description    String?
  visibility     String       @default("WORKSPACE") // PERSONAL | TEAM | WORKSPACE
  filtersJson    String       @default("{}")
  displayJson    String       @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ProjectWorkItemSubscription {
  id         String          @id @default(uuid())
  workItemId String
  workItem   ProjectWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@unique([workItemId, employeeId])
}

model ProjectActivityLog {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  workItemId     String?
  workItem       ProjectWorkItem? @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  actorId        String
  actor          Employee         @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action         String           // CREATED | STATUS_CHANGED | PRIORITY_CHANGED | ASSIGNED | COMMENTED | CYCLE_MOVED | LABELED
  field          String?
  oldValue       String?
  newValue       String?
  createdAt      DateTime         @default(now())

  @@index([organizationId, createdAt])
  @@index([workItemId, createdAt])
}

model ProjectSlaRule {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamId            String?
  team              ProjectTeam? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name              String
  priority          String       @default("URGENT") // URGENT | HIGH | MEDIUM | LOW
  responseMinutes   Int          @default(60)
  resolutionMinutes Int          @default(1440)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model ProjectStatusUpdate {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId     String
  author       Employee @relation(fields: [authorId], references: [id], onDelete: Cascade)
  healthStatus String   @default("ON_TRACK") // ON_TRACK | AT_RISK | OFF_TRACK
  summary      String
  createdAt    DateTime @default(now())

  @@index([projectId, createdAt])
}

model ProjectStaffHandover {
  id                   String    @id @default(uuid())
  projectId            String
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId           String
  employee             Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  docTitle             String?
  docUrl               String?
  docSummary           String?
  technologiesUsedJson String?   // JSON array of { name, category, role }
  submissionStatus     String    @default("PENDING") // PENDING | SUBMITTED | VERIFIED
  submittedAt          DateTime?
  verifiedById         String?
  verifiedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([projectId, employeeId])
}

model ProjectCredentialEntry {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  toolName        String
  category        String   @default("TECH_STACK") // TECH_STACK | CLOUD_HOSTING | DATABASE | GITHUB | MEDIA_PLATFORM | OPS_PORTAL | HARDWARE
  environment     String   @default("PROD") // PROD | STAGING | DEV
  loginUrl        String?
  username        String
  encryptedSecret String
  iv              String
  authTag         String
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId, employeeId])
}

model ProjectIssueTemplate {
  id                String   @id @default(uuid())
  organizationId    String
  teamId            String?
  name              String
  projectType       String   @default("SOFTWARE")
  defaultPriority   String   @default("MEDIUM")
  defaultLabelsJson String?
  subtasksJson      String   // JSON array of subtask titles
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([organizationId])
}

model ProjectChatChannel {
  id           String               @id @default(uuid())
  projectId    String
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  departmentId String?
  channelType  String               @default("DEPARTMENT") // GENERAL | DEPARTMENT | SQUAD | BLOCKERS | HANDOVER
  slug         String
  name         String
  description  String?
  isPrivate    Boolean              @default(false)
  createdById  String
  createdAt    DateTime             @default(now())
  messages     ProjectChatMessage[]

  @@unique([projectId, slug])
  @@index([projectId, departmentId])
}

model ProjectChatMessage {
  id               String               @id @default(uuid())
  projectId        String
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channelId        String
  channel          ProjectChatChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId         String
  author           Employee             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentMessageId  String?
  parentMessage    ProjectChatMessage?  @relation("ChatThread", fields: [parentMessageId], references: [id], onDelete: Cascade)
  replies          ProjectChatMessage[] @relation("ChatThread")
  body             String
  isAnnouncement   Boolean              @default(false)
  isPinned         Boolean              @default(false)
  linkedWorkItemId String?
  attachmentsJson  String?
  reactionsJson    String?
  mentionsJson     String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([channelId, createdAt])
  @@index([parentMessageId])
}

model CustomAdminProfile {
  id              String            @id @default(uuid())
  name            String            @unique
  description     String?
  permissionsJson String            @default("{}")
  createdById     String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  employees       Employee[]
  invitations     AdminInvitation[]
}

// ============================================================
// OPERATIONS MANAGEMENT SYSTEM (OMS - PHASE 1)
// ============================================================

model OpsSite {
  id                 String   @id @default(uuid())
  organizationId     String
  departmentId       String?
  code               String   @unique
  name               String
  siteType           String   @default("OFFICE") // OFFICE | BRANCH | WAREHOUSE | FIELD_SITE | HUB
  stateRegion        String?
  address            String?
  timeZone           String   @default("Africa/Lagos")
  operatingHoursJson String?
  contactName        String?
  contactPhone       String?
  supervisorId       String?
  status             String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workOrders         OpsWorkOrder[]
  dispatches         OpsDispatchAssignment[]

  @@index([organizationId, status])
  @@index([supervisorId])
}

model OpsServiceDefinition {
  id                   String   @id @default(uuid())
  organizationId       String
  departmentId         String?
  code                 String   @unique
  name                 String
  category             String   @default("FIELD_SERVICE") // FIELD_SERVICE | MAINTENANCE | LOGISTICS | ADMIN_SUPPORT | CLIENT_DELIVERY
  description          String?
  ownerId              String?
  slaAcknowledgeMins   Int      @default(60)
  slaResolveHours      Int      @default(24)
  requiresVerification Boolean  @default(false)
  requiresApproval     Boolean  @default(false)
  isClientFacing       Boolean  @default(false)
  status               String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workOrders           OpsWorkOrder[]

  @@index([organizationId, status])
}

model OpsWorkOrder {
  id                String    @id @default(uuid())
  workOrderNumber   String    @unique
  organizationId    String
  siteId            String?
  site              OpsSite?  @relation(fields: [siteId], references: [id], onDelete: SetNull)
  serviceId         String?
  service           OpsServiceDefinition? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  departmentId      String?
  parentWorkOrderId String?
  parentWorkOrder   OpsWorkOrder?  @relation("OpsSubWorkOrders", fields: [parentWorkOrderId], references: [id], onDelete: SetNull)
  subWorkOrders     OpsWorkOrder[] @relation("OpsSubWorkOrders")
  sourceType        String    @default("INTERNAL") // INTERNAL | SERVICE_REQUEST | FINANCE_LINK | PROJECT_HANDOVER | SCHEDULED
  title             String
  description       String?
  priority          String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status            String    @default("NEW") // NEW | TRIAGED | ASSIGNED | SCHEDULED | IN_PROGRESS | AWAITING_INPUT | BLOCKED | REVIEW | COMPLETED | CLOSED | CANCELLED
  blockedReason     String?
  requesterId       String
  ownerId           String?
  assigneeId        String?
  supervisorId      String?
  approverId        String?
  dueAt             DateTime?
  acknowledgedAt    DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  verifiedAt        DateTime?
  closedAt          DateTime?
  checklistJson     String?
  evidenceUrlsJson  String?
  linkedRequestId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  dispatches        OpsDispatchAssignment[]
  workLogs          OpsWorkLog[]
  approvals         OpsApprovalDecision[]

  @@index([organizationId, status])
  @@index([assigneeId, status])
  @@index([requesterId])
  @@index([siteId])
  @@index([dueAt])
}

model OpsDispatchAssignment {
  id               String       @id @default(uuid())
  workOrderId      String
  workOrder        OpsWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  organizationId   String
  siteId           String?
  site             OpsSite?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  assigneeId       String
  dispatcherId     String
  plannedDate      DateTime
  windowStart      String?
  windowEnd        String?
  dispatchStatus   String       @default("ASSIGNED") // UNASSIGNED | ASSIGNED | ACCEPTED | EN_ROUTE | ON_SITE | COMPLETED | FAILED | REASSIGNED
  notes            String?
  reassignedFromId String?
  reassignReason   String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, plannedDate])
  @@index([assigneeId, dispatchStatus])
  @@index([workOrderId])
}

model OpsWorkLog {
  id              String       @id @default(uuid())
  workOrderId     String
  workOrder       OpsWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  actorId         String
  entryType       String       @default("COMMENT") // COMMENT | STATE_CHANGE | EVIDENCE | APPROVAL | DISPATCH
  fromStatus      String?
  toStatus        String?
  message         String
  attachmentsJson String?
  createdAt       DateTime     @default(now())

  @@index([workOrderId, createdAt])
}

model OpsApprovalDecision {
  id             String       @id @default(uuid())
  workOrderId    String
  workOrder      OpsWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  organizationId String
  initiatorId    String
  approverId     String?
  decision       String       @default("PENDING") // PENDING | APPROVED | REJECTED | REVISION_REQUESTED
  reason         String?
  decidedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, decision])
  @@index([workOrderId])
}

// ============================================================
// OPERATIONS MANAGEMENT SYSTEM (OMS - PHASES 2, 3 & 4)
// ============================================================

model OpsSopDocument {
  id                    String   @id @default(uuid())
  organizationId        String
  serviceId             String?
  code                  String   @unique
  title                 String
  version               String   @default("1.0")
  content               String
  checklistTemplateJson String?
  status                String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdById           String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([organizationId, status])
}

model OpsInspection {
  id                   String   @id @default(uuid())
  organizationId       String
  siteId               String?
  workOrderId          String?
  sopId                String?
  inspectorId          String
  title                String
  checklistResultsJson String?
  scorePct             Int      @default(100)
  outcome              String   @default("PASS") // PASS | FAIL | CONDITIONAL
  notes                String?
  inspectedAt          DateTime @default(now())

  @@index([organizationId, outcome])
  @@index([siteId])
}

model OpsIncident {
  id               String    @id @default(uuid())
  incidentNumber   String    @unique
  organizationId   String
  siteId           String?
  workOrderId      String?
  reporterId       String
  ownerId          String?
  severity         String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  category         String    @default("OPERATIONAL") // OPERATIONAL | SAFETY | SECURITY | DEVICE | QUALITY
  title            String
  description      String
  rootCause        String?
  correctiveAction String?
  status           String    @default("OPEN") // OPEN | INVESTIGATING | CONTAINED | RESOLVED | CLOSED
  reportedAt       DateTime  @default(now())
  resolvedAt       DateTime?

  @@index([organizationId, status, severity])
  @@index([siteId])
}

model OpsAsset {
  id               String    @id @default(uuid())
  assetTag         String    @unique
  organizationId   String
  siteId           String?
  name             String
  category         String    @default("EQUIPMENT") // EQUIPMENT | DEVICE | FACILITY | TOOL
  serialNumber     String?
  custodianId      String?
  condition        String    @default("GOOD") // GOOD | FAIR | FAULTY | OUT_OF_SERVICE
  status           String    @default("AVAILABLE") // AVAILABLE | ASSIGNED | MAINTENANCE | RETIRED
  lastServiceAt    DateTime?
  nextServiceDueAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([organizationId, status])
  @@index([custodianId])
}

model OpsShiftHandover {
  id                String    @id @default(uuid())
  organizationId    String
  siteId            String?
  shiftLabel        String
  outgoingOfficerId String
  incomingOfficerId String?
  openItemsSummary  String
  incidentsSummary  String?
  criticalRisks     String?
  acknowledgedAt    DateTime?
  createdAt         DateTime  @default(now())

  @@index([organizationId, createdAt])
  @@index([incomingOfficerId])
}

model OpsStockItem {
  id             String   @id @default(uuid())
  organizationId String
  siteId         String?
  sku            String   @unique
  name           String
  unit           String   @default("PCS")
  quantityOnHand Int      @default(0)
  reorderLevel   Int      @default(5)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  movements      OpsStockMovement[]

  @@index([organizationId, siteId])
}

model OpsStockMovement {
  id           String       @id @default(uuid())
  stockItemId  String
  stockItem    OpsStockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  movementType String       // IN | OUT | ADJUST | RETURN
  quantity     Int
  workOrderId  String?
  actorId      String
  reason       String
  createdAt    DateTime     @default(now())

  @@index([stockItemId, createdAt])
}

model OpsFleetVehicle {
  id               String    @id @default(uuid())
  plateNumber      String    @unique
  organizationId   String
  siteId           String?
  model            String
  driverId         String?
  status           String    @default("AVAILABLE") // AVAILABLE | ON_TRIP | MAINTENANCE | INACTIVE
  odometerKm       Int       @default(0)
  nextServiceDueAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  logs             OpsFleetLog[]

  @@index([organizationId, status])
  @@index([driverId])
}

model OpsFleetLog {
  id            String          @id @default(uuid())
  vehicleId     String
  vehicle       OpsFleetVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  workOrderId   String?
  driverId      String
  tripPurpose   String
  startKm       Int             @default(0)
  endKm         Int?
  fuelCostMinor BigInt          @default(0)
  createdAt     DateTime        @default(now())

  @@index([vehicleId, createdAt])
}

model OpsReconciliationRun {
  id             String   @id @default(uuid())
  organizationId String
  period         String
  sourceSystem   String   // FINANCE | STOCK | FLEET | DEVICE
  matchedCount   Int      @default(0)
  exceptionCount Int      @default(0)
  status         String   @default("OPEN") // OPEN | VERIFIED_BY_FINANCE | CLOSED
  createdById    String
  verifiedById   String?
  createdAt      DateTime @default(now())

  exceptions     OpsReconciliationException[]

  @@index([organizationId, status])
}

model OpsReconciliationException {
  id             String               @id @default(uuid())
  runId          String
  run            OpsReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  exceptionType  String               // MISSING | DUPLICATE | UNMATCHED | DELAYED
  referenceCode  String
  ownerId        String?
  resolutionNote String?
  status         String               @default("OPEN") // OPEN | RESOLVED
  createdAt      DateTime             @default(now())

  @@index([runId, status])
}

model OpsAutomationRule {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  triggerEvent   String   // WORK_ORDER_OVERDUE | INCIDENT_CRITICAL | STOCK_LOW | HANDOVER_UNACKNOWLEDGED
  conditionJson  String?
  actionType     String   // ESCALATE | NOTIFY | ASSIGN_ROLE
  targetRoleOrId String
  isActive       Boolean  @default(true)
  createdById    String
  createdAt      DateTime @default(now())

  @@index([organizationId, isActive])
}
