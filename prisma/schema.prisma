model PerformanceImprovementPlan {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       Employee     @relation("PipSubject", fields: [employeeId], references: [id])
  supervisorId   String
  supervisor     Employee     @relation("PipSupervisor", fields: [supervisorId], references: [id])
  startDate      String
  endDate        String
  goalsSummary   String
  status         String       @default("ACTIVE") // ACTIVE | COMPLETED_PASS | EXTENDED | FAILED
