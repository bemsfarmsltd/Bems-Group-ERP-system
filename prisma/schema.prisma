datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id              String   @id @default(uuid())
  parentGroupId   String?
  type            String   // GROUP | SUBSIDIARY
  legalName       String
  code            String   @unique
  status          String   @default("ACTIVE") // ACTIVE | INACTIVE
  defaultCurrency String   @default("NGN")
  timezone        String   @default("Africa/Lagos")
  logoUrl         String?
  brandColor      String?  @default("#ea580c")
  createdAt       DateTime @default(now())
  effectiveStart  DateTime @default(now())

  departments          Department[]
  employeeAssignments  EmployeeAssignment[]
  expenditureRequests  ExpenditureRequest[]
  disbursements        Disbursement[]
  sourceNotes          IntercompanyNote[]   @relation("SourceEntity")
  targetNotes          IntercompanyNote[]   @relation("TargetEntity")
  budgets              Budget[]
  payrollAllocations   PayrollItemAllocation[]
  settings             WorkspaceSetting[]
  adminInvitations     AdminInvitation[]
  bankAccounts         CompanyBankAccount[]
  attendanceStations   AttendanceStation[]
  attendancePolicy     AttendancePolicy?
  notifications        SystemNotification[]
  staffDisputes        StaffDispute[]
  announcements        CompanyAnnouncement[]
  payrollDeductions    PayrollDeductionAdjustment[]
  employeeLoans        EmployeeLoan[]
  hrRequestTickets     HrRequestTicket[]
  hrDocumentTemplates  HrDocumentTemplate[]
  employeeDocuments    EmployeeDocument[]
  kpiDefinitions       KpiDefinition[]
  performanceCycles    PerformanceReviewCycle[]
  performancePlans     PerformanceImprovementPlan[]
  disciplinaryCases    DisciplinaryCase[]
  grievanceCases       EmployeeGrievanceCase[]
  jobVacancies         JobVacancy[]
  trainingCourses      TrainingCourse[]
  projectPortfolios    ProjectPortfolio[]
  projectGoals         ProjectGoal[]
  projects             Project[]
  projectWorkflows     ProjectWorkflow[]
  projectIntakeForms   ProjectIntakeForm[]
  projectAutomations   ProjectAutomationRule[]
  projectTeams         ProjectTeam[]
  projectLabels        ProjectLabel[]
  projectSavedViews    ProjectSavedView[]
  projectSlaRules      ProjectSlaRule[]
  projectActivityLogs  ProjectActivityLog[]
}

model CompanyBankAccount {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankName           String
  accountName        String
  accountNumber      String       @unique
  accountType        String       @default("Corporate Operational") // Corporate Operational | Corporate Escrow | Operational Float
  currency           String       @default("NGN")
  balance            Decimal      @default(0.0) @db.Decimal(18, 2)
  dailyLimit         Decimal      @default(25000000.0) @db.Decimal(18, 2)
  tier               String       @default("Primary Maker-Checker")
  status             String       @default("ACTIVE") // ACTIVE | INACTIVE | FROZEN
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([organizationId, status])
}

model WorkspaceSetting {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  value          String
  updatedById    String
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId, updatedAt])
}

model Department {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  code           String

  employeeAssignments EmployeeAssignment[]
  kpiDefinitions      KpiDefinition[]
  jobVacancies        JobVacancy[]
  projects            Project[]
  projectWorkItems    ProjectWorkItem[]
}

model Employee {
  id             String   @id @default(uuid())
  employeeNumber String   @unique
  legalName      String
  workEmail      String
  phone          String?
  role           String   // SYSTEM_ADMIN (Super admin) | CUSTOM_ADMIN (Custom Admin) | GMD (The Group Managing Director) | STAFF (Staff)
  status         String   @default("ACTIVE") // ACTIVE | ON_LEAVE | TERMINATED
  approvalStatus String   @default("APPROVED") // PENDING_APPROVAL | APPROVED | REJECTED
  passwordHash   String?
  securityPinHash String?
  walletApprovalCredential WalletApprovalCredential?
  avatarUrl      String?
  
  // Enhanced Enterprise Dossier
  gender                String?   // MALE | FEMALE | OTHER
  dateOfBirth           String?
  residentialAddress    String?
  cityState             String?
  jobTitle              String?
  employmentType        String?   @default("FULL_TIME") // FULL_TIME | CONTRACT | INTERN | PROBATION | PART_TIME
  resumptionDate        DateTime? @default(now())

  // Disbursement Banking
  bankName              String?
  accountNumber         String?
  accountName           String?

  // Dedicated Salary Banking (Optional; defaults to disbursement account)
  salaryBankName        String?
  salaryAccountNumber   String?
  salaryAccountName     String?

  // Emergency / Next of Kin
  nextOfKinName         String?
  nextOfKinPhone        String?
  nextOfKinRelationship String?
  nextOfKinAddress      String?

  // Enhanced Enterprise Dossier & Statutory Identity
  maritalStatus         String?   // SINGLE | MARRIED | DIVORCED | WIDOWED
  stateOfOrigin         String?
  lga                   String?
  nin                   String?   // National Identification Number (11 digits)
  bvn                   String?   // Bank Verification Number (11 digits)
  workLocation          String?   // LAGOS_HQ | BENIN_OPS_HUB | ABUJA_OFFICE | FIELD_REMOTE
  staffGrade            String?   // JUNIOR_OFFICER | OFFICER | SENIOR_OFFICER | TEAM_LEAD | MANAGER
  highestEducation      String?   // SSCE | OND | HND | BSC | MSC | PHD

  // Offline / Field Staff Support (HR Manual Enrollment)
  isOfflineStaff        Boolean   @default(false)
  isAttendanceExempt    Boolean   @default(false) // When true, staff is exempt from signing attendance and excluded from daily roster
  kioskPin              String?   // 4-digit PIN for /attendance/kiosk check-in without a smartphone
  onboardedById         String?

  // Custom Named Admin Profile (4-Level Granular Access Scope)
  customAdminProfileId  String?
  customAdminTitle      String?
  customAdminProfile    CustomAdminProfile? @relation(fields: [customAdminProfileId], references: [id], onDelete: SetNull)

  // Staff App Module Access (Flutter Staff App & Mobile APK)
  staffAppModulesJson   String?   // JSON array of allowed module keys e.g. ["finance","projects"]

  createdAt      DateTime @default(now())

  authSessions   AuthSession[]
  notifications  SystemNotification[]
  notificationPreference NotificationPreference?
  disputesFiled  StaffDispute[]         @relation("EmployeeDisputes")
  disputesResolved StaffDispute[]       @relation("ResolvedDisputes")
  disputeMessages StaffDisputeMessage[]
  announcements  CompanyAnnouncement[]
  paymentConfirmations RecipientPaymentConfirmation[]

  assignments           EmployeeAssignment[]
  employmentAgreements  EmploymentAgreement[]
  expenditureRequests   ExpenditureRequest[]
  disbursementAssignments ExpenditureRequest[] @relation("DisbursementAssignee")
  approvalSteps         ApprovalStep[]
  disbursementsRecorded Disbursement[]       @relation("RecordedBy")
  verificationsDone     PaymentVerification[]
  accountabilityOwned   AccountabilityCase[]  @relation("CaseOwner")
  accountabilityVerified AccountabilityCase[] @relation("CaseVerifier")
  tasksAssigned         FollowupTask[]
  payrollItems          PayrollItem[]
  payrollBatchesAssigned PayrollBatch[] @relation("PayrollDisbursementAssignee")
  payrollPaymentsReceived Disbursement[] @relation("PayrollBeneficiary")
  goodsReceiptsReceived GoodsReceiptNote[]
  adminMessages         StaffAdminMessage[]
  attendanceRecords     AttendanceRecord[]
  workSchedule          StaffWorkSchedule?
  profileUpdateRequests StaffProfileUpdateRequest[] @relation("TargetEmployee")
  createdProfileUpdateRequests StaffProfileUpdateRequest[] @relation("RequestedByAdmin")
  salaryChangeProposals SalaryChangeProposal[]
  leaveRequests         LeaveRequest[]
  deviceTokens          DevicePushToken[]
  payrollDeductions     PayrollDeductionAdjustment[]
  employeeLoans         EmployeeLoan[]
  hrRequestTickets      HrRequestTicket[]
  employeeDocuments     EmployeeDocument[]
  kpiDefinitions        KpiDefinition[]
  evaluationsReceived   PerformanceEvaluation[] @relation("EvaluationSubject")
  evaluationsGiven      PerformanceEvaluation[] @relation("EvaluationReviewer")
  pipsReceived          PerformanceImprovementPlan[] @relation("PipSubject")
  pipsSupervised        PerformanceImprovementPlan[] @relation("PipSupervisor")
  disciplinaryCases     DisciplinaryCase[]
  grievancesReported    EmployeeGrievanceCase[] @relation("GrievanceReporter")
  grievancesAgainst     EmployeeGrievanceCase[] @relation("GrievanceAgainst")
  trainingAssignments   EmployeeTrainingAssignment[]
  ledProjects           Project[] @relation("ProjectManager")
  teamLeadProjects      Project[] @relation("ProjectTeamLead")
  sponsoredProjects     Project[] @relation("ProjectSponsor")
  projectMemberships    ProjectMember[]
  staffHandovers        ProjectStaffHandover[]
  credentialEntries     ProjectCredentialEntry[]
  chatMessages          ProjectChatMessage[]
  assignedWorkItems     ProjectWorkItem[] @relation("WorkItemAssignee")
  reportedWorkItems     ProjectWorkItem[] @relation("WorkItemReporter")
  reviewedWorkItems     ProjectWorkItem[] @relation("WorkItemReviewer")
  projectComments       ProjectComment[]
  projectTimeEntries    ProjectTimeEntry[]
  ownedProjectRisks     ProjectRisk[]
  projectTeamMemberships ProjectTeamMember[]
  workItemSubscriptions  ProjectWorkItemSubscription[]
  projectStatusUpdates   ProjectStatusUpdate[]
  projectActivityLogs    ProjectActivityLog[]

  @@unique([workEmail, role])
  @@index([workEmail])
}

model SalaryChangeProposal {
  id                 String    @id @default(uuid())
  employeeId         String
  employee           Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  proposedById       String
  proposedByName     String
  changeType         String    // INITIAL | SET_EXACT | ADDITION | DEDUCTION
  previousGrossMinor BigInt    @default(0)
  proposedGrossMinor BigInt
  reason             String
  allocationsJson    String?   // Optional JSON array of [{ subsidiaryId, percentage }]
  status             String    @default("PENDING_APPROVAL") // PENDING_APPROVAL | APPROVED | REJECTED
  decidedById        String?
  decidedByName      String?
  decisionNote       String?
  decidedAt          DateTime?
  createdAt          DateTime  @default(now())

  @@index([status, createdAt])
  @@index([employeeId, status])
}

model StaffProfileUpdateRequest {
  id              String    @id @default(uuid())
  employeeId      String
  employee        Employee  @relation("TargetEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  requestedById   String
  requestedBy     Employee  @relation("RequestedByAdmin", fields: [requestedById], references: [id])
  
  requestedFields String    // JSON string array of keys: ["avatarUrl", "nin", "bankDetails", "nextOfKin", "residentialAddress", "demographics", "securityPin"]
  instructions    String?
  
  status          String    @default("PENDING") // PENDING | COMPLETED | CANCELLED
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([employeeId, status])
}

model AuthSession {
  id        String   @id @default(uuid())
  employeeId String
  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([employeeId, expiresAt])
}

model SystemNotification {
  id           String        @id @default(uuid())
  employeeId   String
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  subsidiaryId String?
  subsidiary   Organization? @relation(fields: [subsidiaryId], references: [id])
  category     String        @default("INFORMATIONAL") // ATTENDANCE, PAYROLL_DEDUCTIONS, REQUESTS_APPROVALS, LEAVE, MESSAGES, TASKS, ANNOUNCEMENTS, SECURITY
  priority     String        @default("INFORMATIONAL") // CRITICAL, IMPORTANT, INFORMATIONAL
  kind         String        // Granular event key
  title        String
  body         String
  metadata     Json?         // Structured data: { grossMinor, deductionMinor, netMinor, minutesLate, disputeId, etc. }
  actionLabel  String?       // e.g. "Dispute Deduction", "View Payslip", "Confirm Attendance"
  actionUrl    String?       // e.g. "/disputes", "/payroll", "/attendance"
  readAt       DateTime?
  linkUrl      String?
  createdAt    DateTime      @default(now())

  @@index([employeeId, readAt, createdAt])
  @@index([employeeId, category, priority])
  @@index([subsidiaryId, category])
}

model StaffDispute {
  id              String                @id @default(uuid())
  disputeNumber   String                @unique // e.g. DSP-2026-0001
  employeeId      String
  employee        Employee              @relation("EmployeeDisputes", fields: [employeeId], references: [id], onDelete: Cascade)
  subsidiaryId    String
  subsidiary      Organization          @relation(fields: [subsidiaryId], references: [id])
  category        String                // ATTENDANCE, LATENESS, DEDUCTION, PAYROLL, HR_DECISION
  targetRecordId  String?               // ID of the AttendanceRecord or PayrollItem
  title           String
  explanation     String
  evidenceUrls    String[]              @default([])
  status          String                @default("OPEN") // OPEN, UNDER_REVIEW, APPROVED, REJECTED, CLOSED
  resolutionNotes String?
  resolvedById    String?
  resolvedBy      Employee?             @relation("ResolvedDisputes", fields: [resolvedById], references: [id])
  resolvedAt      DateTime?
  messages        StaffDisputeMessage[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([employeeId, status])
  @@index([subsidiaryId, status])
}

model StaffDisputeMessage {
  id         String       @id @default(uuid())
  disputeId  String
  dispute    StaffDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  senderId   String
  sender     Employee     @relation(fields: [senderId], references: [id])
  senderRole String
  body       String
  createdAt  DateTime     @default(now())

  @@index([disputeId, createdAt])
}

model NotificationPreference {
  id                 String   @id @default(uuid())
  employeeId         String   @unique
  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceAlerts   Boolean  @default(true)
  taskAlerts         Boolean  @default(true)
  messageAlerts      Boolean  @default(true)
  announcementAlerts Boolean  @default(true)
  leaveAlerts        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model CompanyAnnouncement {
  id           String        @id @default(uuid())
  title        String
  content      String
  category     String        @default("COMPANY_WIDE") // COMPANY_WIDE, DEPARTMENTAL, POLICY, HOLIDAY, TRAINING
  priority     String        @default("INFORMATIONAL") // CRITICAL, IMPORTANT, INFORMATIONAL
  subsidiaryId String?       // null = Group-wide
  subsidiary   Organization? @relation(fields: [subsidiaryId], references: [id])
  departmentId String?
  authorId     String
  author       Employee      @relation(fields: [authorId], references: [id])
  publishedAt  DateTime      @default(now())
  expiresAt    DateTime?

  @@index([subsidiaryId, publishedAt])
}

model EmployeeAssignment {
  id           String       @id @default(uuid())
  employeeId   String
  employee     Employee     @relation(fields: [employeeId], references: [id])
  subsidiaryId String
  subsidiary   Organization @relation(fields: [subsidiaryId], references: [id])
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id])
  positionName String
  startsOn     DateTime     @default(now())
  endsOn       DateTime?
  isPrimary    Boolean      @default(true)
  status       String       @default("ACTIVE")
}

model EmploymentAgreement {
  id               String                  @id @default(uuid())
  employeeId       String
  employee         Employee                @relation(fields: [employeeId], references: [id])
  employerEntityId String
  agreementType    String                  @default("PERMANENT") // PERMANENT | CONTRACT | CONSULTANT
  startDate        DateTime                @default(now())
  endDate          DateTime?
  paymentModel     String                  @default("GROUP_PAID") // GROUP_PAID | ENTITY_PAID
  status           String                  @default("ACTIVE")

  compensations    CompensationAgreement[]
  payrollItems     PayrollItem[]
}

model CompensationAgreement {
  id                      String              @id @default(uuid())
  employmentAgreementId   String
  employmentAgreement     EmploymentAgreement @relation(fields: [employmentAgreementId], references: [id])
  grossMinor              BigInt              // in kobo (1 NGN = 100 kobo)
  currency                String              @default("NGN")
  recurrence              String              @default("MONTHLY")
  effectiveFrom           DateTime            @default(now())
  effectiveTo             DateTime?
  version                 Int                 @default(1)
  approvedBy              String?
  changeType              String?
  changeReason            String?

  costAllocations         CostAllocation[]
}

model CostAllocation {
  id                      String                @id @default(uuid())
  compensationAgreementId String
  compensationAgreement   CompensationAgreement @relation(fields: [compensationAgreementId], references: [id])
  subsidiaryId            String
  percentage              Float                 // e.g. 60.0, 40.0 (sum should be 100.0)
  effectiveFrom           DateTime              @default(now())
  effectiveTo             DateTime?
  chargeBasis             String                @default("PAYROLL_COST")
}

model Vendor {
  bankCode String?
  bankFingerprint String?
  verifiedBankAt DateTime? @db.Timestamptz(6)
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  category      String   // IT_SERVICES | LOGISTICS | FACILITIES | LEGAL | GENERAL
  taxId         String?
  contactEmail  String?
  contactPhone  String?
  bankName      String?
  accountNumber String?
  accountName   String?
  rating        Int      @default(5)
  notes         String?
  createdAt     DateTime @default(now())

  requests      ExpenditureRequest[]
  invoices      VendorInvoice[]
}

model ExpenditureRequest {
  id                   String        @id @default(uuid())
  requestNumber        String        @unique // e.g. REQ-2026-0001
  groupId              String
  subsidiaryId         String
  subsidiary           Organization  @relation(fields: [subsidiaryId], references: [id])
  requestedById        String
  requester            Employee      @relation(fields: [requestedById], references: [id])
  vendorId             String?
  vendor               Vendor?       @relation(fields: [vendorId], references: [id])
  requestType          String        @default("ORDINARY") // ORDINARY | ADVANCE | REIMBURSEMENT
  category             String        // IT_SOFTWARE | OFFICE_EXPENSE | TRAVEL | LOGISTICS | MARKETING | ASSET
  amountMinor          BigInt        // In minor units (kobo)
  currency             String        @default("NGN")
  title                String
  justification        String
  deliverable          String
  neededBy             DateTime
  requestVersion       Int           @default(1)
  
  // Independent Status Axes (Section 39)
  approvalStatus       String        @default("SUBMITTED") // DRAFT | SUBMITTED | IN_REVIEW | CLARIFICATION_REQUESTED | APPROVED | REJECTED
  paymentStatus        String        @default("UNPAID")    // UNPAID | AWAITING_RECIPIENT_CONFIRMATION | RECIPIENT_CONFIRMED | RECIPIENT_REPORTED_ISSUE
  accountabilityStatus String        @default("PENDING")   // PENDING | EVIDENCE_SUBMITTED | VERIFIED | CLOSED

  isRecurring          Boolean       @default(false)
  recurringInterval    String?       // MONTHLY | QUARTERLY | ANNUAL
  recurringAutoPay     Boolean       @default(false)
  recurringNextDueAt   DateTime?
  recurringLastPaidAt  DateTime?
  recurringReminderSentAt DateTime?
  disbursementAssigneeId String?
  disbursementAssignee Employee?     @relation("DisbursementAssignee", fields: [disbursementAssigneeId], references: [id])
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  channel              RequestChannel?
  approvalSteps        ApprovalStep[]
  disbursements        Disbursement[]
  accountabilityCase   AccountabilityCase?
  attachments          Attachment[]
  invoices             VendorInvoice[]
  goodsReceipts        GoodsReceiptNote[]
  threeWayMatch        ThreeWayMatchRecord?
  projectId            String?
  project              Project?      @relation(fields: [projectId], references: [id])
  workItemId           String?
  workItem             ProjectWorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)
}

model RequestChannel {
  id             String           @id @default(uuid())
  requestId      String           @unique
  request        ExpenditureRequest @relation(fields: [requestId], references: [id])
  classification String           @default("GENERAL") // GENERAL | CONFIDENTIAL_PAYROLL
  openedAt       DateTime         @default(now())
  archivedAt     DateTime?
  active         Boolean          @default(true)

  messages       ChannelMessage[]
  tasks          FollowupTask[]
}

model ChannelMessage {
  id             String         @id @default(uuid())
  channelId      String
  channel        RequestChannel @relation(fields: [channelId], references: [id])
  authorId       String?
  authorName     String
  authorRole     String
  body           String
  visibility     String         @default("GROUP") // GROUP | PRIVATE
  recipientId    String?
  messageType    String         @default("USER") // USER | SYSTEM | CLARIFICATION | AUDIT_EVENT
  attachmentUrl  String?
  attachmentName String?
  createdAt      DateTime       @default(now())
}

model ApprovalPolicy {
  id                 String   @id @default(uuid())
  scopeSubsidiaryId  String?
  category           String?
  minAmountMinor     BigInt   @default(0)
  maxAmountMinor     BigInt?
  requiredRole       String   // GMD (The Group Managing Director)
  priority           Int      @default(1)
  active             Boolean  @default(true)
}

model ApprovalStep {
  id             String             @id @default(uuid())
  requestId      String
  request        ExpenditureRequest @relation(fields: [requestId], references: [id])
  stageIndex     Int
  assignedRole   String             // GMD (The Group Managing Director)
  approverId     String?
  approver       Employee?          @relation(fields: [approverId], references: [id])
  approverName   String?
  status         String             @default("PENDING") // PENDING | APPROVED | REJECTED | SKIPPED
  decidedAt      DateTime?
  decisionReason String?
  createdAt      DateTime           @default(now())
}

model Disbursement {
  id                 String              @id @default(uuid())
  requestId          String?
  request            ExpenditureRequest? @relation(fields: [requestId], references: [id])
  payrollItemId      String?             @unique
  payrollItem        PayrollItem?        @relation(fields: [payrollItemId], references: [id])
  beneficiaryEmployeeId String?
  beneficiaryEmployee Employee?          @relation("PayrollBeneficiary", fields: [beneficiaryEmployeeId], references: [id])
  payerOrgId         String
  payerOrg           Organization        @relation(fields: [payerOrgId], references: [id])
  beneficiaryName    String
  beneficiaryBank    String
  beneficiaryAccount String
  amountMinor        BigInt
  currency           String              @default("NGN")
  externalReference  String              @unique // Bank Transfer Reference
  bankName           String              // Bank executed through (e.g. GTBank)
  paidAt             DateTime            @default(now())
  recordedById       String
  recordedBy         Employee            @relation("RecordedBy", fields: [recordedById], references: [id])
  status             String              @default("AWAITING_RECIPIENT_CONFIRMATION") // AWAITING_RECIPIENT_CONFIRMATION | RECIPIENT_CONFIRMED | RECIPIENT_REPORTED_ISSUE
  idempotencyKey     String              @unique
  createdAt          DateTime            @default(now())

  receipt            PaymentReceipt?
  verification       PaymentVerification?
  recipientConfirmation RecipientPaymentConfirmation?
}

model RecipientPaymentConfirmation {
  id             String       @id @default(uuid())
  disbursementId String       @unique
  disbursement   Disbursement @relation(fields: [disbursementId], references: [id])
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id])
  decision       String       // RECEIVED | NOT_RECEIVED | AMOUNT_MISMATCH
  note           String?
  confirmedAt    DateTime     @default(now())
}

model PaymentReceipt {
  id             String       @id @default(uuid())
  disbursementId String       @unique
  disbursement   Disbursement @relation(fields: [disbursementId], references: [id])
  fileName       String
  fileUrl        String
  sha256         String       @unique // Prevents duplicate receipt fraud
  mimeType       String
  fileData       Bytes?
  uploadedById   String
  uploadedAt     DateTime     @default(now())
}

model PaymentVerification {
  id                  String       @id @default(uuid())
  disbursementId      String       @unique
  disbursement        Disbursement @relation(fields: [disbursementId], references: [id])
  verifierId          String
  verifier            Employee     @relation(fields: [verifierId], references: [id])
  decision            String       @default("VERIFIED") // VERIFIED | REJECTED
  supportingReference String?
  verifiedAt          DateTime     @default(now())
  reason              String?
}

model AccountabilityCase {
  id                   String             @id @default(uuid())
  requestId            String             @unique
  request              ExpenditureRequest @relation(fields: [requestId], references: [id])
  ownerUserId          String
  owner                Employee           @relation("CaseOwner", fields: [ownerUserId], references: [id])
  verifierUserId       String?
  verifier             Employee?          @relation("CaseVerifier", fields: [verifierUserId], references: [id])
  requiredDeliverables String
  dueAt                DateTime
  status               String             @default("OPEN") // OPEN | EVIDENCE_SUBMITTED | VERIFIED | CLOSED
  verifiedAt           DateTime?
  closureNotes         String?
  createdAt            DateTime           @default(now())

  tasks                FollowupTask[]
}

model FollowupTask {
  id                   String              @id @default(uuid())
  accountabilityCaseId String?
  accountabilityCase   AccountabilityCase? @relation(fields: [accountabilityCaseId], references: [id])
  channelId            String?
  channel              RequestChannel?     @relation(fields: [channelId], references: [id])
  assigneeId           String
  assignee             Employee            @relation(fields: [assigneeId], references: [id])
  description          String
  dueAt                DateTime
  status               String              @default("PENDING") // PENDING | COMPLETED | OVERDUE
  completedAt          DateTime?
  responseNotes        String?
  responseAttachmentUrl String?
}

model PayrollPeriod {
  id         String   @id @default(uuid())
  groupId    String
  year       Int
  month      Int      // 1-12
  startsOn   DateTime
  endsOn     DateTime
  lockStatus String   @default("OPEN") // OPEN | LOCKED | ARCHIVED

  batches    PayrollBatch[]
  notes      IntercompanyNote[]
  deductionAdjustments PayrollDeductionAdjustment[]
}

model PayrollBatch {
  id                String         @id @default(uuid())
  periodId          String
  period            PayrollPeriod  @relation(fields: [periodId], references: [id])
  paymentEntityId   String?
  payrollType       String         @default("REGULAR") // REGULAR | SUPPLEMENTAL
  version           Int            @default(1)
  status            String         @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | DISBURSED
  approvedAt        DateTime?
  totalGrossMinor   BigInt         @default(0)
  totalNetMinor     BigInt         @default(0)
  snapshotHash      String?
  disbursementAssigneeId String?
  disbursementAssignee Employee? @relation("PayrollDisbursementAssignee", fields: [disbursementAssigneeId], references: [id])

  // Single Bulk Clearing Account (Submitted by HR for GMD Lump-Sum Transfer)
  clearingBankName      String?
  clearingAccountNumber String?
  clearingAccountName   String?
  submittedById         String?
  submittedByName       String?
  submissionNote        String?

  // GMD Lump-Sum Funding & Reconciliation Ledger
  bulkFundedAt          DateTime?
  bulkFundedAmountMinor BigInt?
  bulkFundingBankName   String?
  bulkFundingReference  String?
  bulkFundingReceiptUrl String?

  createdAt         DateTime       @default(now())

  items             PayrollItem[]
}

model PayrollItem {
  id                       String                 @id @default(uuid())
  batchId                  String
  batch                    PayrollBatch           @relation(fields: [batchId], references: [id])
  employeeId               String
  employee                 Employee               @relation(fields: [employeeId], references: [id])
  agreementId              String
  agreement                EmploymentAgreement    @relation(fields: [agreementId], references: [id])
  grossMinor               BigInt
  employeeDeductionsMinor  BigInt                 // PAYE + Pension
  employerCostMinor        BigInt                 // Employer Pension contribution
  netMinor                 BigInt
  currency                 String                 @default("NGN")
  status                   String                 @default("CALCULATED")

  allocations              PayrollItemAllocation[]
  disbursement             Disbursement?
}

model PayrollItemAllocation {
  id                 String      @id @default(uuid())
  itemId             String
  item               PayrollItem @relation(fields: [itemId], references: [id])
  subsidiaryId       String
  subsidiary         Organization @relation(fields: [subsidiaryId], references: [id])
  allocableCostMinor BigInt
  percentage         Float
}

model IntercompanyNote {
  id               String        @id @default(uuid())
  periodId         String?
  period           PayrollPeriod? @relation(fields: [periodId], references: [id])
  sourceEntityId   String
  sourceEntity     Organization  @relation("SourceEntity", fields: [sourceEntityId], references: [id])
  targetEntityId   String
  targetEntity     Organization  @relation("TargetEntity", fields: [targetEntityId], references: [id])
  noteType         String        // DEBIT_NOTE | CREDIT_NOTE
  noteNumber       String        @unique // e.g. DN-2026-10-001
  totalAmountMinor BigInt
  currency         String        @default("NGN")
  description      String
  status           String        @default("ISSUED") // DRAFT | ISSUED | RECONCILED
  generatedAt      DateTime      @default(now())
}

model AuditEvent {
  id            String   @id @default(uuid())
  actorId       String?
  actorName     String
  actorRole     String
  groupId       String
  subsidiaryId  String?
  targetType    String   // REQUEST | DISBURSEMENT | PAYROLL | POLICY
  targetId      String
  action        String   // CREATED | APPROVED | REJECTED | CLARIFICATION_REQUESTED | PAID | VERIFIED | CLOSED
  beforeHash    String?
  afterHash     String?
  metadata      String?  // JSON string
  correlationId String
  module        String?
  ipAddress     String?
  userAgent     String?
  deviceLabel   String?
  createdAt     DateTime @default(now())
}

model Attachment {
  id           String              @id @default(uuid())
  ownerType    String              // REQUEST | DISBURSEMENT | ACCOUNTABILITY
  ownerId      String?
  requestId    String?
  request      ExpenditureRequest? @relation(fields: [requestId], references: [id])
  fileName     String
  fileUrl      String
  checksum     String?
  contentType  String
  fileData     Bytes?
  notes        String?
  uploadedById String
  uploadedAt   DateTime            @default(now())
}

model Budget {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  fiscalYear       Int
  fiscalPeriod     String       // ANNUAL | Q1 | Q2 | Q3 | Q4 | MONTHLY
  periodName       String       // e.g. "Q4 2026 - Push", "October 2026"
  totalAmount      Float
  committedAmount  Float        @default(0)
  spentAmount      Float        @default(0)
  status           String       @default("ACTIVE") // DRAFT | ACTIVE | LOCKED | CLOSED
  warningThreshold Float        @default(80.0) // % warning
  createdById      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  lines            BudgetLine[]
  projectId        String?
  project          Project?     @relation(fields: [projectId], references: [id])
}

model BudgetLine {
  id              String      @id @default(uuid())
  budgetId        String
  budget          Budget      @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  departmentName  String      // e.g. "Cloud & Engineering", "Fleet Operations"
  category        String      // e.g. "IT Infrastructure", "Diesel & Logistics"
  expenseType     String      @default("OPEX") // OPEX | CAPEX
  allocatedAmount Float
  committedAmount Float       @default(0)
  spentAmount     Float       @default(0)
  status          String      @default("ACTIVE") // ACTIVE | FROZEN
}

model VendorInvoice {
  id               String               @id @default(uuid())
  vendorId         String
  vendor           Vendor               @relation(fields: [vendorId], references: [id])
  requestId        String?
  request          ExpenditureRequest?  @relation(fields: [requestId], references: [id])
  invoiceNumber    String
  invoiceDate      DateTime             @default(now())
  amountMinor      BigInt
  taxMinor         BigInt               @default(0)
  currency         String               @default("NGN")
  fileAttachmentId String?
  status           String               @default("PENDING") // PENDING | MATCHED | VARIANCE_FLAGGED | REJECTED
  createdAt        DateTime             @default(now())

  matchingRecord   ThreeWayMatchRecord?
}

model GoodsReceiptNote {
  id              String               @id @default(uuid())
  requestId       String
  request         ExpenditureRequest   @relation(fields: [requestId], references: [id])
  grnNumber       String               @unique // e.g. GRN-2026-0001
  receivedById    String
  receivedBy      Employee             @relation(fields: [receivedById], references: [id])
  receivedAt      DateTime             @default(now())
  waybillNumber   String?
  inspectionNotes String?
  status          String               @default("ACCEPTED") // ACCEPTED | PARTIAL | DAMAGED

  matchingRecord  ThreeWayMatchRecord?
}

model ThreeWayMatchRecord {
  id                 String             @id @default(uuid())
  requestId          String             @unique
  request            ExpenditureRequest @relation(fields: [requestId], references: [id])
  invoiceId          String             @unique
  invoice            VendorInvoice      @relation(fields: [invoiceId], references: [id])
  grnId              String?            @unique
  grn                GoodsReceiptNote?  @relation(fields: [grnId], references: [id])
  poAmountMinor      BigInt
  invoiceAmountMinor BigInt
  varianceMinor      BigInt
  status             String             @default("MATCH_CONFIRMED") // MATCH_CONFIRMED | PRICE_VARIANCE | MISSING_GRN
  matchedAt          DateTime           @default(now())
}

model OutboundNotification {
  id         String   @id @default(uuid())
  channel    String   // SLACK | WHATSAPP
  recipient  String   // phone or slack user/channel ID
  eventType  String   // APPROVAL_REQUESTED | DISBURSED | RETIREMENT_WARNING
  payload    String   // JSON string of message sent
  status     String   // SENT | FAILED | DELIVERED
  externalId String?  // message ts or wamid
  createdAt  DateTime @default(now())
}

model DevicePushToken {
  id          String   @id @default(uuid())
  employeeId  String
  token       String   @unique
  platform    String   @default("ANDROID") // ANDROID | IOS | WEB
  deviceModel String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([token])
}

model StagedAction {
  id                    String    @id // sa_[uuid]
  userId                String    // ID of GMD or SYSTEM_ADMIN
  actionType            String    // budget | approval_decision | payment_record | salary_change | payment_recorder
  commandVersion        Int       @default(1)
  conversationId        String?   // Bound conversation / session ID (e.g. conv_<actorId>)
  targetSubsidiaryId    String?   // Resolved target subsidiary / organization ID
  targetEntityType      String?   // Target record type (e.g. fund_request, employee, budget)
  targetEntityId        String?   // Immutable target record ID
  expectedVersion       String?   // Expected version or timestamp of target before commit
  eligibleApproverRoles String    @default("GMD,SUPER_ADMIN") // Comma-separated canonical approver roles
  attachmentIds         String?   // JSON array of verified Attachment IDs staged with proposal
  sideEffectStatus      String    @default("NOT_APPLICABLE") // NOT_APPLICABLE | PENDING | DELIVERED | PARTIAL_FAILURE
  sideEffectLogJson     String?   // JSON array of external side-effect delivery outcomes
  confirmationHash      String    // sha256:...
  payload               String    // JSON string of material input parameters
  summary               String
  previewJson           String    // JSON string of before-and-after preview
  warnings              String?   // JSON array of strings
  blockingErrors        String?   // JSON array of strings
  status                String    @default("PENDING") // PENDING | EXECUTED | CANCELLED | EXPIRED
  expiresAt             DateTime  // CreatedAt + 15 minutes
  executedAt            DateTime?
  idempotencyKey        String?   // X-Correlation-Id / Idempotency-Key
  resultJson            String?   // JSON string of committed record read-back
  auditEventId          String?
  createdAt             DateTime  @default(now())

  @@index([userId, status])
  @@index([conversationId])
  @@index([targetSubsidiaryId, status])
  @@index([expiresAt])
  @@index([idempotencyKey])
}

model AdminInvitation {
  id                   String              @id @default(uuid())
  workEmail            String
  role                 String              // SYSTEM_ADMIN (Super admin) | GMD (The Group Managing Director)
  subsidiaryId         String
  subsidiary           Organization        @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)
  departmentId         String?
  positionName         String?
  customAdminProfileId String?
  customAdminTitle     String?
  customAdminProfile   CustomAdminProfile? @relation(fields: [customAdminProfileId], references: [id], onDelete: SetNull)
  token                String              @unique
  invitedById          String
  status               String              @default("PENDING") // PENDING | COMPLETED | EXPIRED | REVOKED
  expiresAt            DateTime
  createdAt            DateTime            @default(now())

  @@index([workEmail, status])
  @@index([token])
}

model N8nChatHistory {
  id        Int      @id @default(autoincrement())
  sessionId String   @map("session_id")
  message   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("n8n_chat_histories")
}

model StaffAdminMessage {
  id             String    @id @default(uuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  channel        String    @default("GMD") // "GMD" (Confidential Executive Line) | "HR" (HR Operations Helpdesk)
  senderRole     String    // "STAFF" | "GMD" | "HR" | "SYSTEM_ADMIN"
  senderId       String    // ID of the employee sending
  senderName     String
  message        String
  attachmentUrl  String?
  attachmentName String?
  isReadByStaff  Boolean   @default(false)
  isReadByAdmin  Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([employeeId, channel, createdAt])
  @@index([channel, createdAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  email     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, expiresAt])
}

model MobileAppGate {
  id                     String   @id @default(uuid())
  appId                  String   @unique // GMD_APP | STAFF_APP
  appName                String   // "BEMS GMD AI" | "BEMS Staff App"
  packageName            String   // "com.bemsgroup.gmd_ai" | "com.bemsgroup.staff"
  minimumAllowedVersion  String   @default("1.0.0")
  latestVersionAvailable String   @default("1.0.0")
  forceUpdate            Boolean  @default(true)
  directDownloadUrl      String   @default("https://bemserp.work/download/gmd-app.apk")
  upgradePromptNotes     String?
  updatedAt              DateTime @updatedAt
  updatedById            String?

  releases               MobileAppRelease[]
}

model MobileAppRelease {
  id          String         @id @default(uuid())
  appId       String         // GMD_APP | STAFF_APP
  appGate     MobileAppGate? @relation(fields: [appId], references: [appId], onDelete: Cascade)
  version     String         // e.g. "1.0.1"
  fileName    String         // e.g. "BemsGmdAi-v1.0.1.apk"
  fileSize    String         // e.g. "58.4 MB"
  downloadUrl String         // e.g. "/downloads/gmd-app.apk"
  status      String         @default("ACTIVE") // ACTIVE | ARCHIVE
  notes       String?
  uploadedBy  String         // Admin email
  createdAt   DateTime       @default(now())

  @@index([appId, status])
}

model AttendanceStation {
  id                      String       @id @default(uuid())
  organizationId          String
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                    String       // E.g. "Lagos Corporate HQ - Reception Kiosk"
  code                    String       @unique // E.g. "LAGOS-HQ-K1"
  stateLocation           String?      // E.g. "Abia State", "Edo State", "Imo State", "Lagos State"
  latitude                Float
  longitude               Float
  radiusMeters            Int          @default(100)
  starlinkOverrideMode    String       @default("INHERIT") // INHERIT | ENFORCE | BYPASS
  starlinkIpAddresses     String?      // Per-location Starlink public IP subnets/prefixes
  requireGeofenceOverride Boolean?     // null = inherit policy, true = enforce, false = bypass
  activeSecret            String       // Salt for rotating QR generation
  status                  String       @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  records        AttendanceRecord[]

  @@index([organizationId, status])
}

model AttendancePolicy {
  id                       String       @id @default(uuid())
  organizationId           String       @unique
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  earliestCheckInTime      String       @default("07:00") // No check-in allowed before 07:00 AM
  resumptionTime           String       @default("08:00") // HH:mm
  closingTime              String       @default("17:00") // HH:mm
  gracePeriodMinutes       Int          @default(15)      // Up to 08:15 AM
  latenessDeductionPercent Float        @default(5.0)     // Deduct 5% of daily rate
  absenceDeductionPercent  Float        @default(100.0)   // Deduct 100% of daily rate
  requireGeofence          Boolean      @default(true)
  requireQrScan            Boolean      @default(true)
  requireStarlinkIp        Boolean      @default(true)    // Starlink Wi-Fi connection required
  starlinkIpAddresses      String       @default("")      // Comma-separated Starlink IPs / subnets
  starlinkPowerOutageMode  Boolean      @default(false)   // Quick toggle for power outage emergency fallback
  updatedById              String?
  updatedAt                DateTime     @updatedAt
}

model StaffWorkSchedule {
  id             String    @id @default(uuid())
  employeeId     String    @unique
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  weeklyOffDays  String    @default("0,6") // Comma-separated: 0=Sun, 6=Sat
  customShiftIn  String?   // E.g. "08:00"
  customShiftOut String?   // E.g. "17:00"
  isExempt       Boolean   @default(false)
  notes          String?
  updatedAt      DateTime  @updatedAt
}

model AttendanceRecord {
  id                 String             @id @default(uuid())
  employeeId         String
  employee           Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  stationId          String?
  station            AttendanceStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  workDate           String             // YYYY-MM-DD
  
  checkInTime        DateTime?
  checkInLat         Float?
  checkInLng         Float?
  checkInDistanceM   Float?
  clientIp           String?            // Recorded IP at punch
  
  checkOutTime       DateTime?
  checkOutLat        Float?
  checkOutLng        Float?
  checkOutDistanceM  Float?

  status             String             @default("PRESENT") // PRESENT | LATE | HALF_DAY | ABSENT | EXCUSED | OFF_DAY
  isManualOverride   Boolean            @default(false)
  overrideReason     String?
  overrideById       String?
  
  isDeductionApplied Boolean            @default(false)
  deductionPercent   Float              @default(0.0)
  deductionMinor     BigInt             @default(0)
  payrollItemId      String?

  // HR Excuse Request (Requires GMD / Super Admin Approval to Waive Deduction)
  excuseStatus          String          @default("NONE") // NONE | PENDING_GMD_APPROVAL | APPROVED | REJECTED
  excuseRequestNote     String?
  excuseRequestedByName String?

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([employeeId, workDate])
  @@index([workDate, status])
  @@index([employeeId, workDate])
}

model StoredFile {
  id        String   @id @default(uuid())
  filename  String   @unique
  mimeType  String   @default("image/jpeg")
  data      Bytes
  size      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([filename])
}

model LeaveRequest {
  id             String    @id @default(uuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      String    // ANNUAL | SICK | CASUAL | MATERNITY | PATERNITY | COMPASSIONATE | STUDY
  startDate      String    // YYYY-MM-DD
  endDate        String    // YYYY-MM-DD
  reason         String
  handoverNotes  String?
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  reviewedById   String?
  reviewedByName String?
  reviewNote     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([employeeId, status])
  @@index([status, createdAt])
}



model SecurityRateLimit {
  key             String   @id
  attempts        Int
  windowStartedAt DateTime @db.Timestamptz(6)
  blockedUntil    DateTime? @db.Timestamptz(6)
  expiresAt       DateTime  @db.Timestamptz(6)

  @@index([expiresAt])
}

model DeliveryOutbox {
  id            String    @id
  commandId     String
  kind          String
  payload       String
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @db.Timestamptz(6)
  lockedUntil   DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  sentAt        DateTime? @db.Timestamptz(6)
  lastError     String?

  @@index([status, nextAttemptAt])
  @@index([commandId])
}

// Internal staff-wallet foundation. Access through canonical wallet services;
// no provider sub-wallet is created and no old approval is backfilled as value.
model WalletFundingPool {
  id              String   @id
  environment     String
  sourceAccount   String
  availableMinor  BigInt
  feeReserveMinor BigInt
  observedAt      DateTime @db.Timestamptz(6)
  observationId   String
  paused          Boolean  @default(true)
  version         Int      @default(1)
}

model WalletBudgetEnvelope {
  id             String   @id
  organizationId String
  label          String
  allocatedMinor BigInt
  remainingMinor BigInt
  createdById    String
  parentId       String?
  status         String @default("ACTIVE")
  version        Int @default(1)
  idempotencyKey String   @unique
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
}

model WalletReleaseProposal {
  id               String   @id
  createdById      String
  sourceType       String
  sourceId         String
  envelopeId       String?
  employeeId       String?
  conversationId   String?
  workspaceId      String?
  amountMinor      BigInt
  category         String
  sourceHash       String
  confirmationHash String
  expiresAt        DateTime @db.Timestamptz(6)
  status           String   @default("PENDING")
  approvedById     String?
  approvedAt       DateTime? @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
}

model WalletCreditLot {
  id             String   @id
  proposalId     String
  releaseItemId  String? @unique
  requestId String?
  payrollItemId String?
  frozen         Boolean @default(false)
  sourceType     String
  sourceId       String
  employeeId     String
  organizationId String
  category       String
  amountMinor    BigInt
  availableMinor BigInt
  returnedMinor  BigInt   @default(0)
  heldMinor      BigInt   @default(0)
  settledMinor   BigInt   @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([sourceType, sourceId, organizationId])
  @@index([employeeId, createdAt], map: "WalletCreditLot_owner")
}

model WalletJournal {
  id        String   @id
  kind      String
  reference String   @unique
  actorId   String
  postingTx BigInt @default(dbgenerated("txid_current()"))
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

model WalletJournalEntry {
  id          String @id
  journalId   String
  accountKey  String
  amountMinor BigInt

  @@index([journalId], map: "WalletJournalEntry_journal")
}

model WalletReleaseItem {
  id String @id
  proposalId String
  sourceType String
  sourceId String
  employeeId String?
  organizationId String
  envelopeId String
  amountMinor BigInt
  category String
  @@unique([proposalId, sourceType, sourceId, organizationId])
 vendorId String?
 bankSnapshot String?
}

model WalletBankAccount {
  id String @id
  employeeId String
  accountNumber String
  bankCode String
  accountName String
  fingerprint String
  active Boolean @default(true)
  verifiedAt DateTime @default(now()) @db.Timestamptz(6)
  @@unique([employeeId, fingerprint])
}

model WalletApprovalCredential {
  employeeId String @id
  pinHash String
  failedAttempts Int @default(0)
  lockedAt DateTime? @db.Timestamptz(6)
  recoveryUntil DateTime? @db.Timestamptz(6)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model WalletChallenge {
  id String @id
  actorId String
  purpose String
  payloadHash String
  tokenHash String
  sessionHash String
  credentialHash String
  expiresAt DateTime @db.Timestamptz(6)
  usedAt DateTime? @db.Timestamptz(6)
  approvalPinHash String?
  otpDigest String?
  otpVerifiedAt DateTime? @db.Timestamptz(6)
  otpAttempts Int @default(0)
  @@index([expiresAt], map: "WalletChallenge_expiry")
}

model WalletWithdrawal {
  id String @id
  employeeId String
  amountMinor BigInt
  feeLimitMinor BigInt
  feeMinor BigInt @default(0)
  reference String @unique
  idempotencyKey String
  intentHash String
  environment String
  sourceAccount String
  bankAccountId String?
  bankCode String
  accountNumber String
  accountName String
  status String @default("HELD")
  providerReference String?
  providerStatus String?
  submittedAt DateTime? @db.Timestamptz(6)
  leaseToken String?
  leaseUntil DateTime? @db.Timestamptz(6)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz(6)
  attempts Int @default(0)
  lastError String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  @@unique([employeeId, idempotencyKey])
  @@index([status, nextAttemptAt], map: "WalletWithdrawal_queue")
 targetType String @default("STAFF")
 vendorId String?
 requestId String?
 proposalId String?
}

model WalletWithdrawalAllocation {
  id String @id
  withdrawalId String
  creditLotId String
  amountMinor BigInt
  @@unique([withdrawalId, creditLotId])
}

model WalletProviderInbox {
  processedAt DateTime? @db.Timestamptz(6)
  id String @id
  bodyHash String @unique
  reference String
  eventType String
  receivedAt DateTime @default(now()) @db.Timestamptz(6)
}

model WalletReconciliationIssue {
  id String @id
  reference String?
  code String
  detail String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  resolvedAt DateTime? @db.Timestamptz(6)
