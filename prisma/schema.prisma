  organization   Organization?      @relation(fields: [organizationId], references: [id])
  docType        String             // OFFER_LETTER | EMPLOYMENT_CONTRACT | CONFIRMATION_LETTER | PROMOTION_LETTER | SALARY_ADJUSTMENT | TRANSFER_LETTER | WARNING_LETTER | LEAVE_APPROVAL | NDA | EXIT_CLEARANCE | EXPERIENCE_LETTER | POLICY | CERTIFICATE | OTHER
