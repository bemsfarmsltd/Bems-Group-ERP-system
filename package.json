{
  "name": "fund-request-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "backend:dev": "node scripts/run-typescript.cjs backend/server.ts",
    "backend:build": "prisma generate && npx esbuild backend/server.ts --bundle --platform=node --target=node22 --packages=external --banner:js=\"process.env.TOKIO_WORKER_THREADS=process.env.TOKIO_WORKER_THREADS||'1';process.env.RAYON_NUM_THREADS=process.env.RAYON_NUM_THREADS||'1';process.env.UV_THREADPOOL_SIZE=process.env.UV_THREADPOOL_SIZE||'2';\" --outfile=dist/backend/server.js",
    "backend:start": "NODE_ENV=production node dist/backend/server.js",
    "build": "prisma generate && rm -rf .next/standalone && next build && node scripts/patch-standalone-server.cjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:platform": "node scripts/run-typescript.cjs scripts/verify-platform-architecture.ts",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "test:security": "node scripts/run-typescript.cjs scripts/regression-security.ts",
    "outbox:process": "node scripts/run-typescript.cjs scripts/process-outbox.ts",
    "test:database": "node scripts/run-typescript.cjs scripts/regression-database.ts && node scripts/run-typescript.cjs scripts/regression-scoped-reads.ts && node scripts/run-typescript.cjs scripts/regression-outbox.ts",
    "corrections:preflight": "node scripts/run-typescript.cjs scripts/preflight-corrections.ts",
    "test:wallet": "node scripts/run-wallet-regressions.cjs && node scripts/run-group-regressions.cjs && node scripts/run-typescript.cjs scripts/regression-wallet-client.ts",
    "wallet:process": "node scripts/run-typescript.cjs scripts/process-wallet-transfers.ts",
    "wallet:preflight": "node scripts/run-typescript.cjs scripts/wallet-preflight.ts",
    "wallet:reconcile": "node scripts/run-typescript.cjs scripts/reconcile-wallet.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@prisma/client": "^6.4.1",
    "@sentry/node": "^11.12.0",
    "@tanstack/react-query": "^5.107.1",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.6.1",
    "bullmq": "^6.7.6",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "esbuild": "^0.28.2",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.475.0",
    "next": "^15.2.0",
    "nodemailer": "^10.1.7",
    "pdf-lib": "^1.17.1",
    "pino": "^10.4.0",
    "postcss": "^8.5.30",
    "prisma": "^6.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.34.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "zod": "^4.6.7"
  },
  "overrides": {
    "postcss": "$postcss",
    "deepmerge-ts": "8.0.2",
    "postcss-selector-parser": "7.1.6",
    "braces": "^3.0.3"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  }
}
